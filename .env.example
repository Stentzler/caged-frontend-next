# Local development only. This value remains server-only and must not be committed to .env.local.
CAGED_QUERY_LAMBDA_URL=

# Production only. The Next.js server invokes this function through its EC2 IAM role.
AWS_REGION=
CAGED_QUERY_LAMBDA_FUNCTION_NAME=

# Public links rendered by the server at runtime. Required in production.
SITE_OFFICIAL_SOURCE_URL=
SITE_CBO_SOURCE_URL=
SITE_GITHUB_URL=
SITE_CONTACT_EMAIL=
